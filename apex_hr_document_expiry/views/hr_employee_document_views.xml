<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_document_view_list" model="ir.ui.view">
        <field name="name">hr.employee.document.list</field>
        <field name="model">hr.employee.document</field>
        <field name="arch" type="xml">
            <list string="Employee Documents"
                  decoration-danger="state == 'expired'"
                  decoration-warning="state == 'expiring'"
                  decoration-muted="state == 'renewed'">
                <field name="employee_id"/>
                <field name="document_type"/>
                <field name="document_number"/>
                <field name="issue_date" optional="show"/>
                <field name="expiry_date"/>
                <field name="days_left"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'valid'"
                       decoration-warning="state == 'expiring'"
                       decoration-danger="state == 'expired'"
                       decoration-muted="state == 'renewed'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="hr_employee_document_view_form" model="ir.ui.view">
        <field name="name">hr.employee.document.form</field>
        <field name="model">hr.employee.document</field>
        <field name="arch" type="xml">
            <form string="Employee Document">
                <header>
                    <button name="action_renew" type="object" string="Renew"
                            class="btn-primary"
                            invisible="renewed or not id"/>
                    <field name="state" widget="statusbar" statusbar_visible="valid,expiring,expired"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Renewed" bg_color="text-bg-secondary"
                            invisible="not renewed"/>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="document_type"/>
                            <field name="document_number"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="days_left" invisible="renewed"/>
                            <field name="renewed_from_id" invisible="not renewed_from_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="renewed" invisible="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Attachments">
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_employee_document_view_search" model="ir.ui.view">
        <field name="name">hr.employee.document.search</field>
        <field name="model">hr.employee.document</field>
        <field name="arch" type="xml">
            <search string="Employee Documents">
                <field name="employee_id"/>
                <field name="document_number"/>
                <field name="document_type"/>
                <filter name="filter_expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <filter name="filter_expiring" string="Expiring Soon" domain="[('state', '=', 'expiring')]"/>
                <filter name="filter_valid" string="Valid" domain="[('state', '=', 'valid')]"/>
                <separator/>
                <filter name="filter_active_docs" string="Current (not renewed)" domain="[('renewed', '=', False)]"/>
                <separator/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_type" string="Document Type" context="{'group_by': 'document_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_expiry" string="Expiry Month" context="{'group_by': 'expiry_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hr_employee_document_action" model="ir.actions.act_window">
        <field name="name">Employee Documents</field>
        <field name="res_model">hr.employee.document</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_active_docs': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first employee document</p>
            <p>Track Iqama, passport, visa and other documents and get alerts before they expire.</p>
        </field>
    </record>
</odoo>
