<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Demo employees (fictional) -->
    <record id="demo_emp_ahmed" model="hr.employee">
        <field name="name">Ahmed Khan</field>
        <field name="job_title">Site Engineer</field>
    </record>
    <record id="demo_emp_maria" model="hr.employee">
        <field name="name">Maria Santos</field>
        <field name="job_title">Accountant</field>
    </record>
    <record id="demo_emp_rajesh" model="hr.employee">
        <field name="name">Rajesh Kumar</field>
        <field name="job_title">Crane Operator</field>
    </record>
    <record id="demo_emp_omar" model="hr.employee">
        <field name="name">Omar Al-Harbi</field>
        <field name="job_title">HR Coordinator</field>
    </record>
    <record id="demo_emp_sana" model="hr.employee">
        <field name="name">Sana Iqbal</field>
        <field name="job_title">Safety Officer</field>
    </record>
    <record id="demo_emp_john" model="hr.employee">
        <field name="name">John Mathew</field>
        <field name="job_title">Driver</field>
    </record>

    <!-- Documents: dates are relative to today so every status always shows -->

    <!-- Expired -->
    <record id="demo_doc_john_medical" model="hr.employee.document">
        <field name="employee_id" ref="demo_emp_john"/>
        <field name="document_type">medical</field>
        <field name="document_number">MED-558201</field>
        <field name="issue_date" eval="(datetime.today() - timedelta(days=370)).strftime('%Y-%m-%d')"/>
        <field name="expiry_date" eval="(datetime.today() - timedelta(days=5)).strftime('%Y-%m-%d')"/>
    </record>
    <record id="demo_doc_rajesh_visa" model="hr.employee.document">
        <field name="employee_id" ref="demo_emp_rajesh"/>
        <field name="document_type">visa</field>
        <field name="document_number">VISA-77310</field>
        <field name="issue_date" eval="(datetime.today() - timedelta(days=400)).strftime('%Y-%m-%d')"/>
        <field name="expiry_date" eval="(datetime.today() - timedelta(days=12)).strftime('%Y-%m-%d')"/>
    </record>

    <!-- Expiring soon -->
    <record id="demo_doc_ahmed_iqama" model="hr.employee.document">
        <field name="employee_id" ref="demo_emp_ahmed"/>
        <field name="document_type">iqama</field>
        <field name="document_number">2456789012</field>
        <field name="issue_date" eval="(datetime.today() - timedelta(days=340)).strftime('%Y-%m-%d')"/>
        <field name="expiry_date" eval="(datetime.today() + timedelta(days=7)).strftime('%Y-%m-%d')"/>
    </record>
    <record id="demo_doc_maria_passport" model="hr.employee.document">
        <field name="employee_id" ref="demo_emp_maria"/>
        <field name="document_type">passport</field>
        <field name="document_number">P1234567</field>
        <field name="issue_date" eval="(datetime.today() - timedelta(days=3300)).strftime('%Y-%m-%d')"/>
        <field name="expiry_date" eval="(datetime.today() + timedelta(days=25)).strftime('%Y-%m-%d')"/>
    </record>
    <record id="demo_doc_sana_work_permit" model="hr.employee.document">
        <field name="employee_id" ref="demo_emp_sana"/>
        <field name="document_type">work_permit</field>
        <field name="document_number">WP-90311</field>
        <field name="issue_date" eval="(datetime.today() - timedelta(days=340)).strftime('%Y-%m-%d')"/>
        <field name="expiry_date" eval="(datetime.today() + timedelta(days=18)).strftime('%Y-%m-%d')"/>
    </record>

    <!-- Valid -->
    <record id="demo_doc_ahmed_passport" model="hr.employee.document">
        <field name="employee_id" ref="demo_emp_ahmed"/>
        <field name="document_type">passport</field>
        <field name="document_number">N7654321</field>
        <field name="issue_date" eval="(datetime.today() - timedelta(days=700)).strftime('%Y-%m-%d')"/>
        <field name="expiry_date" eval="(datetime.today() + timedelta(days=2900)).strftime('%Y-%m-%d')"/>
    </record>
    <record id="demo_doc_omar_national_id" model="hr.employee.document">
        <field name="employee_id" ref="demo_emp_omar"/>
        <field name="document_type">national_id</field>
        <field name="document_number">1087654321</field>
        <field name="issue_date" eval="(datetime.today() - timedelta(days=500)).strftime('%Y-%m-%d')"/>
        <field name="expiry_date" eval="(datetime.today() + timedelta(days=1300)).strftime('%Y-%m-%d')"/>
    </record>
    <record id="demo_doc_rajesh_driving" model="hr.employee.document">
        <field name="employee_id" ref="demo_emp_rajesh"/>
        <field name="document_type">driving</field>
        <field name="document_number">DL-44821</field>
        <field name="issue_date" eval="(datetime.today() - timedelta(days=200)).strftime('%Y-%m-%d')"/>
        <field name="expiry_date" eval="(datetime.today() + timedelta(days=160)).strftime('%Y-%m-%d')"/>
    </record>
    <record id="demo_doc_john_iqama" model="hr.employee.document">
        <field name="employee_id" ref="demo_emp_john"/>
        <field name="document_type">iqama</field>
        <field name="document_number">2398765432</field>
        <field name="issue_date" eval="(datetime.today() - timedelta(days=120)).strftime('%Y-%m-%d')"/>
        <field name="expiry_date" eval="(datetime.today() + timedelta(days=245)).strftime('%Y-%m-%d')"/>
    </record>

    <!-- Renewal history: old (renewed) + new (valid) -->
    <record id="demo_doc_maria_visa_old" model="hr.employee.document">
        <field name="employee_id" ref="demo_emp_maria"/>
        <field name="document_type">visa</field>
        <field name="document_number">VISA-20114</field>
        <field name="issue_date" eval="(datetime.today() - timedelta(days=740)).strftime('%Y-%m-%d')"/>
        <field name="expiry_date" eval="(datetime.today() - timedelta(days=10)).strftime('%Y-%m-%d')"/>
        <field name="renewed" eval="True"/>
    </record>
    <record id="demo_doc_maria_visa_new" model="hr.employee.document">
        <field name="employee_id" ref="demo_emp_maria"/>
        <field name="document_type">visa</field>
        <field name="document_number">VISA-31872</field>
        <field name="issue_date" eval="(datetime.today() - timedelta(days=8)).strftime('%Y-%m-%d')"/>
        <field name="expiry_date" eval="(datetime.today() + timedelta(days=722)).strftime('%Y-%m-%d')"/>
        <field name="renewed_from_id" ref="demo_doc_maria_visa_old"/>
    </record>
</odoo>
